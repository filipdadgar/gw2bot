# Host bridge settings
GW2_HOST_BRIDGE_ENABLED=true
GW2_CAPTURE_SOURCE=host
GW2_INPUT_SOURCE=host

# Runtime paths
GW2_DATA_DIR=/app/data

# API settings
GW2_API_HOST=0.0.0.0
GW2_API_PORT=8000

# Training automation (optional)
GW2_TRAINING_AUTO_RETRAIN_ENABLED=false
GW2_TRAINING_RETRAIN_INTERVAL_SECONDS=1800

# Runtime policy loop (optional)
GW2_RUNTIME_POLICY_ENABLED=false
GW2_RUNTIME_POLICY_MIN_CONFIDENCE=0.7
GW2_RUNTIME_SIGNAL_INTERVAL_MS=1000
