# Host bridge settings
GW2_HOST_BRIDGE_ENABLED=true
GW2_CAPTURE_SOURCE=host
GW2_INPUT_SOURCE=host

# Runtime paths
GW2_DATA_DIR=/app/data

# API settings
GW2_API_HOST=0.0.0.0
GW2_API_PORT=8000

# Training automation (mission mode default)
GW2_TRAINING_AUTO_RETRAIN_ENABLED=true
GW2_TRAINING_RETRAIN_INTERVAL_SECONDS=300

# Runtime policy loop (mission mode default)
GW2_RUNTIME_POLICY_ENABLED=true
GW2_RUNTIME_INPUT_ENABLED=true
GW2_RUNTIME_MOUNT_CYCLE_ENABLED=true
GW2_RUNTIME_WAYPOINT_STEERING_ENABLED=true
GW2_RUNTIME_GATHER_LOCK_SECONDS=1.6
GW2_RUNTIME_GATHER_PROMPT_LATCH_SECONDS=2.2
GW2_RUNTIME_POLICY_MIN_CONFIDENCE=0.7
GW2_RUNTIME_SIGNAL_INTERVAL_MS=1000

# Automatically start a run on API startup (mission mode default)
GW2_AUTOSTART_RUN_ENABLED=true

# Manual demonstration capture (optional, host permissions required)
GW2_DEMO_AUTO_CAPTURE_ENABLED=false
